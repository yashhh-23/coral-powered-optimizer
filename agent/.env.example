# GSoC & Open-Source Matchmaker Agent — Environment Variables
# Copy this file to .env and fill in your real values.

# ── Primary LLM (Gemini) ──────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Fallback LLM (Groq) ──────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Coral MCP (optional, defaults to stdio transport) ─────────────
CORAL_MCP_URL=http://localhost:9111/sse

# ── Render Deployment Variables ───────────────────────────────────
# If deploying to a cloud host via Docker, add these environment variables:
GITHUB_TOKEN=your_github_personal_access_token_here
LEETCODE_USERNAME=your_leetcode_username_here

